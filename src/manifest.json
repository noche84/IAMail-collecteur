{
  "manifest_version": 3,
  "name": "IAMail — Collecteur Thunderbird",
  "description": "Relève les nouveaux messages et les archive en .eml + .json nommés (v0, hors ligne, lecture seule).",
  "version": "0.1.3",
  "author": "Arnaud François",
  "browser_specific_settings": {
    "gecko": {
      "id": "iamail-collecteur@noche84",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": ["slug.js", "archive.js", "background.js"]
  },
  "action": {
    "default_title": "IAMail — relever",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
